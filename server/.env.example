# 知寻 KnowSeek 后端环境配置示例。复制为 .env 后按需填写。

# ===== 数据库 =====
# 默认 SQLite（相对路径以 server/ 为基准，随项目迁移无需改）；生产可切换 PostgreSQL（代码兼容）
DATABASE_URL=sqlite:///./ai_assistant.db
# DATABASE_URL=postgresql+psycopg://knowseek:password@localhost:5432/knowseek

# ===== 向量库 =====
# 相对路径以 server/ 为基准；容器部署建议挂载持久卷（如 /data/chroma_data）
CHROMA_DIR=./chroma_data
VECTOR_COLLECTION=kb_default

# ===== JWT =====
# 生产必须替换为强随机值：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=knowseek-dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== QQ 邮箱 SMTP（验证码发送）=====
# 在 QQ 邮箱「设置-账号-安全设置」中开启 SMTP 服务并获取授权码
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
EMAIL_CODE_EXPIRE_MINUTES=5
EMAIL_SEND_INTERVAL_SECONDS=60

# ===== DeepSeek（OpenAI 兼容）=====
# 未配置时服务可运行，LLM 回答走本地降级模式
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT_SECONDS=60

# ===== 文件与 OCR =====
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
# 代码已预留 PaddleOCR 接口；未安装 paddleocr 时扫描件会标记"需 OCR 支持"，建议保持 false
OCR_ENABLED=false
ALLOWED_FILE_TYPES=["pdf","docx","xlsx","pptx","txt","md","png","jpg","jpeg"]

# ===== 切片 =====
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RAG_TOP_K=5

# ===== CORS =====
# 开发本机同时兼容 5173/5174；生产改为真实域名白名单
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# ===== 登录安全 =====
# 连续登录失败锁定；验证码限流
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
SEND_CODE_IP_LIMIT_PER_HOUR=10
SEND_CODE_EMAIL_LIMIT_PER_DAY=10

# ===== 审批超时催办 =====
APPROVAL_REMINDER_HOURS=24
APPROVAL_REMINDER_INTERVAL_MINUTES=60

# ===== 下载水印 =====
# 共享知识库下载叠加"用户名+时间"水印，防泄密溯源
WATERMARK_ENABLED=true

# ===== LLM 高级参数 =====
LLM_FIRST_TOKEN_TIMEOUT_SECONDS=60
LLM_RETRY_TIMES=1

# ===== 安全 =====
# 生产必须保持 false；仅本地联调可开启，验证码明文打印到控制台
DEV_PRINT_CODE=false
